Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 30; 30; 30
    Fixed Frame: course_map
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Floor grid
      Enabled: true
      Cell Size: 1
      Plane: XY
    - Class: rviz_default_plugins/PointCloud2
      Name: Nominal structural map
      Enabled: true
      Topic:
        Value: /course/nominal_map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Style: Points
      Size (Pixels): 2
      Color Transformer: FlatColor
      Color: 160; 160; 160
    - Class: rviz_default_plugins/PointCloud2
      Name: Observations aligned by odometry
      Enabled: true
      Topic:
        Value: /course/observed_points_vo
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 2
      Decay Time: 20
      Style: Points
      Size (Pixels): 2
      Color Transformer: FlatColor
      Color: 0; 220; 255
    - Class: rviz_default_plugins/PointCloud2
      Name: Observations aligned by PF (map-conditioned)
      Enabled: false
      Topic:
        Value: /course/observed_points_pf
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 2
      Decay Time: 20
      Style: Points
      Size (Pixels): 2
      Color Transformer: FlatColor
      Color: 255; 80; 180
    - Class: rviz_default_plugins/PoseArray
      Name: Particles
      Enabled: true
      Topic:
        Value: /course/particles
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 2
      Color: 255; 200; 0
      Shape: Arrow (Flat)
      Arrow Length: 0.12
    - Class: rviz_default_plugins/Odometry
      Name: PF pose
      Enabled: true
      Topic:
        Value: /course/particle_pose
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 2
      Keep: 1
    - Class: rviz_default_plugins/Image
      Name: Stereo depth
      Enabled: true
      Topic:
        Value: /course/stereo_depth
        Reliability Policy: Reliable
        Durability Policy: Volatile
        Depth: 2
      Normalize Range: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 9
      Focal Point: {X: 0, Y: 0, Z: 0.5}
      Pitch: 1.2
      Yaw: 0.8
Window Geometry:
  Width: 1280
  Height: 900
